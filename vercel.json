{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/articles/:path*",
      "destination": "/cwise/articles/:path*",
      "permanent": true
    },
    {
      "source": "/reference/:path*",
      "destination": "/cwise/reference/:path*",
      "permanent": true
    },
    {
      "source": "/news/:path*",
      "destination": "/cwise/news/:path*",
      "permanent": true
    }
  ]
}
